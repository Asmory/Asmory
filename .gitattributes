# Asmory language policy
#
# Count project implementation languages while excluding maintained Shell
# tooling from GitHub Linguist language statistics.
#
# Only make Assembly classification explicit for source suffixes that may vary
# between assemblers/toolchains.

*.S linguist-language=Assembly
*.s linguist-language=Assembly
*.asm linguist-language=Assembly

# Infrastructure / workflow Shell scripts are not part of language stats.
*.sh linguist-detectable=false
